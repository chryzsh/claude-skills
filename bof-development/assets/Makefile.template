# BOF Makefile Template
# 
# Standard template for compiling BOFs on Linux using mingw-w64
# Supports both x64 and x86 architectures

# BOF name - change this to your BOF's name
BOFNAME := mybof

# Common include directory (adjust path as needed)
COMINCLUDE := -I ../../common

# Library includes - add any required Windows libraries
# Common examples:
#   -l iphlpapi     (network interfaces)
#   -l netapi32     (network management)
#   -l advapi32     (registry, security)
#   -l userenv      (user environment)
#   -l wtsapi32     (terminal services)
LIBINCLUDE := 

# Compiler definitions
CC_x64 := x86_64-w64-mingw32-gcc
CC_x86 := i686-w64-mingw32-gcc
CC := x86_64-w64-mingw32-clang

# Compilation flags
CFLAGS := -Os -c -DBOF
TEST_CFLAGS := -g

# Output directory - BOFs are always compiled to dist/
OUTPUT_DIR := dist

# Default target: compile BOF object files for both architectures
all:
	$(CC_x64) -o $(BOFNAME).x64.o $(COMINCLUDE) $(CFLAGS) entry.c
	$(CC_x86) -o $(BOFNAME).x86.o $(COMINCLUDE) $(CFLAGS) entry.c
	mkdir -p $(OUTPUT_DIR)
	mv $(BOFNAME)*.o $(OUTPUT_DIR)

# Test target: compile as executable for local testing
test:
	$(CC_x64) entry.c $(TEST_CFLAGS) $(COMINCLUDE) $(LIBINCLUDE) -o $(BOFNAME).x64.exe
	$(CC_x86) entry.c $(TEST_CFLAGS) $(COMINCLUDE) $(LIBINCLUDE) -o $(BOFNAME).x86.exe

# Scan-build target: static analysis with clang
scanbuild:
	$(CC) entry.c -o $(BOFNAME).scanbuild.exe $(COMINCLUDE) $(LIBINCLUDE)

# Check target: run cppcheck for additional static analysis
check:
	cppcheck --enable=all $(COMINCLUDE) --platform=win64 entry.c

# Clean target: remove compiled executables
clean:
	rm -f $(BOFNAME).*.exe
	rm -f $(BOFNAME).*.o

.PHONY: all test scanbuild check clean
